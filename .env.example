# Database — PostgreSQL connection string
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# For Supabase pooler (port 6543): postgresql+asyncpg://postgres.<project-ref>:<password>@aws-X-region.pooler.supabase.com:6543/postgres
# For direct connection (port 5432): postgresql+asyncpg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://your_db_user:your_db_password@your_db_host:6543/postgres

# JWT Secret Key — generate a strong random key, e.g.:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_super_secret_key_here

# JWT Algorithm — HS256 is standard
ALGORITHM=HS256

# Token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30
